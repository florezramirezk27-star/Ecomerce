# Server
PORT=3001
NODE_ENV=development
# Backend URL used by server-side Next.js rewrites (use https://api.example.com in production)
API_URL=http://localhost:3001
# Browser API URL. Keep /api/proxy to use the same-origin Vercel rewrite.
NEXT_PUBLIC_API_URL=/api/proxy
# Public Socket.IO endpoint (use https://api.example.com in production)
NEXT_PUBLIC_WS_URL=https://ecomerce-vslf.onrender.com
# Exact public web origin allowed by the API
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=
# Pooled Neon URL for the API runtime, with sslmode=require.
# Use Neon direct URL only for migrations if your provider requires it.
DIRECT_URL=

# Upstash Redis TLS connection string. Required when REDIS_REQUIRED=true.
REDIS_URL=
REDIS_REQUIRED=false

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# API Keys
OPENAI_API_KEY=
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=

# Image upload providers
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecommerce.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
ADMIN_GOOGLE_EMAIL=

# Frontend URL (for reset links)
FRONTEND_URL=http://localhost:3000

# Dropi (dropshipping)
# Credenciales de la cuenta Dropi (login para obtener token de la API interna)
DROPI_EMAIL=
DROPI_PASSWORD=
# Nombre de tienda (usado en el login BFF)
DROPI_SHOP_NAME=
# Token oficial de la API de Dropi (formato atkn_...). Habilita media completa y
# endpoints oficiales (todas las imagenes + videos al importar productos).
# Obtener desde la cuenta de Dropi > Configuracion > API.
DROPI_API_TOKEN=
# URL base del CDN de imagenes de Dropi (no cambiar salvo que Dropi migre su CDN).
# Default: CloudFront https://d39ru7awumhhs2.cloudfront.net/
DROPI_CDN=
# Proveedor/bodega por defecto usados al importar productos si no se resuelven
# automaticamente desde el contexto del producto (supplier_id / warehouse_id).
DROPI_SUPPLIER_ID=
DROPI_WAREHOUSE_ID=
# Monto fijo de envio para crear ordenes (default: 8000 COP).
DROPI_SHIPPING_AMOUNT=8000

# Aveonline (dropshipping con API moderna V3 / Avestock)
# La cuenta debe tener habilitado el modulo de API de AveCRM (AuthProduct).
# Si el login V3 falla con "Error en usuario o contraseña", activa la API en
# https://guias.aveonline.co/panel (Mis integraciones / registro de cliente API).
AVEONLINE_USER=
AVEONLINE_PASS=
# Numero de empresa/idempresa (se autocompleta con el login V3).
# Para esta cuenta: 44541
AVEONLINE_EMPRESA=
# Token cifrado compartido por el soporte de Aveonline (no es JWT, pendiente de uso)
AVEONLINE_ENCRYPTED_TOKEN=
# Token unico de integracion que Aveonline envia en cada notificacion de webhook.
# Se autocompleta al registrar el webhook con POST /aveonline/webhook/register.
AVEONLINE_WEBHOOK_TOKEN=
# URL publica de tu API que recibira las notificaciones (ej: https://api.example.com/aveonline/webhook)
AVEONLINE_WEBHOOK_URL=
