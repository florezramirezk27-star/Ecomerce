# Server
PORT=3001
NODE_ENV=development
# Backend URL used by server-side Next.js rewrites (use https://api.example.com in production)
API_URL=http://localhost:3001
# Browser API URL. Keep /api/proxy to use the same-origin Vercel rewrite.
NEXT_PUBLIC_API_URL=/api/proxy
# Public Socket.IO endpoint (use https://api.example.com in production)
NEXT_PUBLIC_WS_URL=https://ecomerce-vslf.onrender.com
# Exact public web origin allowed by the API
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=
# Pooled Neon URL for the API runtime, with sslmode=require.
# Use Neon direct URL only for migrations if your provider requires it.
DIRECT_URL=

# Upstash Redis TLS connection string. Required when REDIS_REQUIRED=true.
REDIS_URL=
REDIS_REQUIRED=false

# Postgres pool and timeouts. Applied only when the value is missing from
# DATABASE_URL, so an explicit URL always wins.
# Without a statement_timeout a single unindexed query can hold a pool
# connection forever and take the whole API down.
# DB_POOL_SIZE: 10 is sensible behind a pooler (Neon/RDS). Without a pooler,
# set it near (CPU cores * 2 + 1) and do not exceed the server's max_connections.
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=15000

# Performance note: this app makes several queries per request and every round
# trip costs the full network latency. A `SELECT 1` was measured at ~100ms from
# a machine outside us-east-2, and a catalog page (count + items) at ~220ms.
# That latency, not the query shape, is what caps throughput. Keep the API in
# the same region as the database, or move the database closer to the API.

# Cache tuning.
# CATALOG_CACHE_TTL: seconds a public catalog read stays cached. Writes
# invalidate explicitly; this only bounds the worst case. 0 disables caching.
CATALOG_CACHE_TTL=60
# SESSION_CACHE_TTL: max seconds a validated session is cached. Bounds how long
# a role change or forced logout takes to take effect.
SESSION_CACHE_TTL_SECONDS=120

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# API Keys
OPENAI_API_KEY=
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=

# Image upload providers
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecommerce.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
ADMIN_GOOGLE_EMAIL=

# Facebook OAuth (Meta for Developers)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# Meta Pixel — ID numerico del Event Manager (en apps/web/.env.local):
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Meta Conversions API (server-side) — token del Event Manager > Configuracion >
# API de conversiones > Generar token. Con el token vacio el backend ignora los
# eventos (no rompe nada).
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# (Opcional) codigo de 12 caracteres de "Ver eventos de prueba" del Event Manager
META_CAPI_TEST_EVENT_CODE=

# Frontend URL (for reset links)
FRONTEND_URL=http://localhost:3000

# Dropi (dropshipping)
# Credenciales de la cuenta Dropi (login para obtener token de la API interna)
DROPI_EMAIL=
DROPI_PASSWORD=
# Nombre de tienda (usado en el login BFF)
DROPI_SHOP_NAME=
# Token oficial de la API de Dropi (formato atkn_...). Habilita media completa y
# endpoints oficiales (todas las imagenes + videos al importar productos).
# Obtener desde la cuenta de Dropi > Configuracion > API.
DROPI_API_TOKEN=
# URL base del CDN de imagenes de Dropi (no cambiar salvo que Dropi migre su CDN).
# Default: CloudFront https://d39ru7awumhhs2.cloudfront.net/
DROPI_CDN=
# Proveedor/bodega por defecto usados al importar productos si no se resuelven
# automaticamente desde el contexto del producto (supplier_id / warehouse_id).
DROPI_SUPPLIER_ID=
DROPI_WAREHOUSE_ID=
# Monto fijo de envio para crear ordenes (default: 8000 COP).
DROPI_SHIPPING_AMOUNT=8000
# Secreto compartido para autenticar POST /dropi/webhook por firma HMAC-SHA256.
# OBLIGATORIO en produccion: sin este valor el endpoint rechaza TODOS los
# webhooks (falla cerrado), porque antes no tenia ninguna proteccion y cualquiera
# podia cambiar el estado de cualquier pedido.
# Dropi firma como: HMAC_SHA256(secret, "<x-dropi-timestamp>.<cuerpo crudo>")
# y envia el resultado hex en `x-dropi-signature` (con o sin prefijo "sha256=").
# La marca de tiempo debe estar en `x-dropi-timestamp` en epoch milisegundos, con
# una tolerancia de 5 minutos, y cada firma se acepta una sola vez.
DROPI_WEBHOOK_SECRET=
