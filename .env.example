# Server
PORT=3001
NODE_ENV=development
# Backend URL used by server-side Next.js rewrites (use https://api.example.com in production)
API_URL=http://localhost:3001
# Browser API URL. Keep /api/proxy to use the same-origin Vercel rewrite.
NEXT_PUBLIC_API_URL=/api/proxy
# Public Socket.IO endpoint (use https://api.example.com in production)
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Exact public web origin allowed by the API
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=
# Pooled Neon URL for the API runtime, with sslmode=require.
# Use Neon direct URL only for migrations if your provider requires it.
DIRECT_URL=

# Upstash Redis TLS connection string. Required when REDIS_REQUIRED=true.
REDIS_URL=
REDIS_REQUIRED=false

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# API Keys
OPENAI_API_KEY=
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=

# Image upload providers
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecommerce.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
ADMIN_GOOGLE_EMAIL=

# Frontend URL (for reset links)
FRONTEND_URL=http://localhost:3000
