# ---------------------------------------------------------------------------
# Variables de entorno — Kronio Market
#
# Este archivo es la lista de TODO lo que el codigo lee. Si algo no aparece
# aqui, el codigo no lo usa.
#
# DONDE VA CADA GRUPO:
#   - Bloques "API (Nest)"      -> Render, en el servicio web de ecomerce-*.onrender.com
#   - Bloques "Web (Next.js)"  -> Vercel, en apps/web
#   - Prisma (migraciones)     -> solo local o en un job, no en el runtime
#
# IMPORTANTE: en un archivo .env las comillas se ignoran, pero en el dashboard
# de Render y de Vercel son parte del valor. Pega
#   postgresql://user:pass@host/db
# y no
#   "postgresql://user:pass@host/db"
# porque las comillas se acaban enviada al servidor y rompen la conexion.
# ---------------------------------------------------------------------------


# =============================================================================
# Web (Next.js) — en Vercel, NO en Render
# =============================================================================

# URL de la API para el renderizado en servidor y para la rewrite /api/proxy.
# next.config.ts avisa en consola si falta: sin ella el SSR y el proxy fallan
# en silencio apuntando a localhost.
API_URL=https://ecomerce-vslf.onrender.com

# URL que usa el NAVEGADOR. Keep /api/proxy para que todo salga por el mismo
# origen y no haya problemas de CORS.
NEXT_PUBLIC_API_URL=/api/proxy

# Endpoint publico de Socket.IO (chat y contador de visitantes en vivo).
# Sin esta variable el chat no tiene socket.
NEXT_PUBLIC_WS_URL=https://ecomerce-vslf.onrender.com

# ID numerico del Event Manager de Meta (pixel).
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Preset de subida unsigned de Cloudinary, para subir desde el navegador.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# CDN de imagenes de Dropi. Default: CloudFront.
NEXT_PUBLIC_DROPI_CDN=


# =============================================================================
# API (Nest) — en Render
# =============================================================================

# --- Servidor ---
# PORT no se configura: Render lo inyecta.
NODE_ENV=production
# Origen exacto permitido por CORS y por el socket. Sin coma: es una sola URL.
CORS_ORIGIN=https://ecomerce-delta-three.vercel.app
# Origen de la web, para los links de recuperacion de contrasena y los
# redirects de Google/Facebook.
FRONTEND_URL=https://ecomerce-delta-three.vercel.app


# --- Base de datos ---
# URL con pooler (el sufijo -pooler) para el runtime de la API.
DATABASE_URL=
# Solo para migraciones de Prisma. Sin pooler, porque las migraciones y el
# pooler no se llevan bien. Un unico neon_db_owner, single connection.
DIRECT_URL=

# Limites del pool y timeouts. Se anaden a DATABASE_URL solo si ya no estan
# dentro, asi que una URL explicada siempre gana.
# DB_POOL_SIZE: 10 es sensato detras de un pooler (Neon/RDS).
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
# Sin statement_timeout, un unico query sin indice retiene una conexion del
# pool indefinidamente y tumba la API entera. En produccion no lo quites.
DB_STATEMENT_TIMEOUT=15000

# Nota de rendimiento: esta app hace varios queries por request y cada ida y
# vuelta cuesta la latencia de red. Un `SELECT 1` se midio en ~100ms desde
# fuera de us-east-2, y una pagina de catalogo (count + items) en ~220ms.
# Esa latencia, no la forma de los queries, es lo que marca el techo. Pon la
# API en la misma region que la base de datos.


# --- Redis (Upstash) ---
# Cadena de conexion TLS de Upstash. Formato exacto:
#   rediss://default:TOKEN@REGION.upstash.io:6379
# El usuario es siempre "default". El esquema tiene que ser rediss:// (TLS);
# con redis:// el codigo no activa TLS. En la consola de Upstash hay dos URLs:
# la rediss:// es la de ioredis, la https:// es la API REST.
REDIS_URL=
# true hace que /ready devuelva 503 si Redis no responde, para que el
# orquestador lo detecte. Sin esto, la API sigue diciendo "ok" con el rate
# limiting desactivado y te enteras por un abuso, no por un log.
# Ponlo en true en produccion.
REDIS_REQUIRED=false
# ms de espera al conectar antes de rendirse.
REDIS_CONNECT_TIMEOUT=5000
# CATALOG_CACHE_TTL: segundos que una lectura publica de catalogo sigue
# cacheada. Las escrituras invalidan de forma explicita, asi que esto solo
# acota el peor caso. 0 desactiva la cache.
CATALOG_CACHE_TTL=60
# SESSION_CACHE_TTL_SECONDS: tope de segundos que una sesion validada se
# cachea. Marca cuanto tarda un cambio de rol o un cierre forzado en notarse.
SESSION_CACHE_TTL_SECONDS=120


# --- Autenticacion ---
# 64 hex aleatorios. Si falta, o vale "dev-secret-key", la app NO arranca.
JWT_SECRET=
# Duracion del access token y de la sesion (refresh). Formato: 30s, 15m, 24h, 7d.
# OJO: el nombre antiguo JWT_EXPIRES_IN no lo lee nadie; sin esto el access
# token dura 1h, que es lo que coge el codigo por defecto.
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Correo con el que se concede el rol de admin al registrarse o al entrar con
# Google/Facebook. ADMIN_EMAIL es el de la tienda; ADMIN_GOOGLE_EMAIL el de
# la cuenta de Google.
ADMIN_EMAIL=
ADMIN_GOOGLE_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con la URI de redireccion de la consola de Google.
GOOGLE_CALLBACK_URL=https://ecomerce-vslf.onrender.com/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=https://ecomerce-vslf.onrender.com/auth/facebook/callback


# --- Inteligencia artificial ---
# KronioBot, el agente de ventas del chat. Usa Gemini.
# Sin GOOGLE_GENERATIVE_AI_API_KEY el chat responde con el clasificador local
# de intents, no con el modelo.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# --- Subida de imagenes ---
# Cloudinary tiene prioridad si esta relleno; si no, se usa S3.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=


# --- Correo ---
# RESEND_API_KEY manda sobre SMTP. Si esta puesta, el correo sale por la API
# HTTP de Resend y el bloque de SMTP de abajo se ignora por completo.
# Es la opcion que funciona en Render, porque ahi los puertos SMTP salientes
# (25, 465 y 587) estan bloqueados en todos los planes y nodemailer solo habla
# SMTP: con SMTP configurado el arranque se come 15s de timeout y el mensaje no
# llega a nadie. Crear la clave en https://resend.com/api-keys (plan gratis:
# 3.000 correos al mes).
RESEND_API_KEY=
# Remitente. Debe ser un dominio verificado en Resend. Sin verificar, se puede
# usar onboarding@resend.dev, que solo entrega a la direccion de la cuenta.
MAIL_FROM=onboarding@resend.dev

# SMTP: solo para correr en local o en un host donde los puertos no esten
# bloqueados. Es el camino de respaldo, no el recomendado.
# App password de Google, con espacios: "abcd efgh ijkl mnop". La contrasena
# normal de la cuenta no sirve.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ecommerce.com


# --- Meta / Facebook Pixel ---
# Se necesitan las DOS: con una sola no se envia nada.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# (Opcional) codigo de 12 caracteres de "Ver eventos de prueba".
META_CAPI_TEST_EVENT_CODE=


# --- Dropi (dropshipping) ---
DROPI_EMAIL=
DROPI_PASSWORD=
# Nombre de la tienda, usado en el login.
DROPI_SHOP_NAME=
# Token oficial de la API de Dropi (formato atkn_...). Sin el, la API interna
# funciona con login, pero la importacion de productos sube SIN imagenes ni
# videos. Obtenido en la cuenta de Dropi > Configuracion > API.
DROPI_API_TOKEN=
# Secreto 2FA de la cuenta, para el login TOTP. Sin el, el login falla si la
# cuenta tiene 2FA activado.
DROPI_2FA_SECRET=
# URL base del CDN de imagenes de Dropi. Default: CloudFront.
# No cambiar salvo que Dropi migre su CDN.
DROPI_CDN=
DROPI_WHITE_BRAND_ID=1
# IDs por defecto para crear pedidos, cuando el producto no los trae.
DROPI_USER_ID=
DROPI_SUPPLIER_ID=
# Ultimo recurso si Dropi rechaza la bodega del proveedor por no tener
# sucursal. El proveedor va primero: es el que Dropi confirma en las ordenes que
# si se crean.
DROPI_WAREHOUSE_ID=
DROPI_DISTRIBUTION_COMPANY_ID=
DROPI_DISTRIBUTION_COMPANY_NAME=
# Cada cuantos minutos se refresca el stock de los productos importados con el
# stock real de Dropi. Default 30. Bajarlo mucho no ayuda: el sync consulta a
# Dropi en serie porque en paralelo las peticiones se descartan.
DROPI_STOCK_SYNC_INTERVAL_MINUTES=30
# Monto fijo de envio (default 8000 COP).
DROPI_SHIPPING_AMOUNT=8000
# Como paga el cliente. Sin esta variable el codigo usa CON RECAUDO, es decir,
# efectivo al recibir. Ponla explicitamente para no depender del default.
# Valores validos: CON RECAUDO | SIN RECAUDO
DROPI_RATE_TYPE=CON RECAUDO
# Secreto compartido para autenticar POST /dropi/webhook por firma
# HMAC-SHA256. OBLIGATORIO en produccion: sin este valor el endpoint rechaza
# TODOS los webhooks (falla cerrado), porque no tendria ninguna proteccion y
# cualquiera podria cambiar el estado de cualquier pedido.
# Dropi firma como: HMAC_SHA256(secret, "<x-dropi-timestamp>.<cuerpo crudo>")
# y manda el hex en `x-dropi-signature` (con o sin prefijo "sha256=").
# La marca de tiempo va en `x-dropi-timestamp` en epoch milisegundos, con una
# tolerancia de 5 minutos, y cada firma se acepta una sola vez.
DROPI_WEBHOOK_SECRET=
# Token propio para autenticar la integracion de la API de Dropi.
DROPI_INTEGRATION_TOKEN=
# Credenciales REST de WooCommerce (formato ck_... / cs_...), para exponer
# /wp-json/wc/v3 y sincronizar pedidos.
DROP_WOO_CK=
DROP_WOO_CS=
