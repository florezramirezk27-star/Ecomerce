generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ChatIntent {
  PURCHASE
  PRODUCT_INFO
  ORDER_STATUS
  SHIPPING
  SUPPORT
  GENERAL
}

enum ConversationState {
  EXPLORING
  COMPARING
  INTENT_TO_BUY
  CHECKOUT_READY
  ABANDONED
  RESOLVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId          String?   @unique
  facebookId        String?   @unique
  role              Role      @default(CUSTOMER)
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  verificationCode        String?
  verificationCodeExpiry  DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  cart      Cart?
  orders    Order[]
  pushDevices PushDevice[]

  sessions      Session[]
  chatSessions  ChatSession[]
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  price       Decimal   @db.Decimal(10,2)
  oldPrice    Decimal?  @db.Decimal(10,2)
  customCode          String?
  /**
   * Landing larga del producto, como HTML/CSS/JS pegado por el admin.
   *
   * Se guarda como texto y se renderiza en un iframe con sandbox en la ficha,
   * para que el CSS y los scripts del codigo no toquen la tienda. `null` o
   * vacio = la ficha se ve normal, sin landing.
   *
   * No se reutiliza `customCode`: ese guarda el SKU del producto.
   */
  landingCode         String?  @db.Text
  dropiProductId      Int?   @unique
  stock               Int
  lowStockThreshold   Int       @default(5)
  image       String?
  gallery     String[]
  video       String?
  videos      String[]
  active      Boolean   @default(true)

  /**
   * Presentaciones (variaciones) de un producto de Dropi con type VARIABLE.
   * Se guarda como JSON para no modelar una tabla entera cuando la tienda solo
   * necesita listar/validar: `[{ id, name, stock }]`, donde `id` es el
   * `variation_id` que exige Dropi al crear la orden. `null`/vacio = producto
   * simple.
   */
  variations  Json?

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  cartItems   CartItem[]
  orderItems  OrderItem[]

  embedding   ProductEmbedding?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
  @@index([categoryId, active])
  @@index([price])
  @@index([active, createdAt])
}

model ProductEmbedding {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vector    Unsupported("vector(1536)")?
  model     String   @default("text-embedding-3-small")
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model DiscountCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  discountType String  @default("PERCENTAGE")
  discountValue Decimal @db.Decimal(5,2)
  minPurchase  Decimal? @db.Decimal(10,2)
  maxUses      Int      @default(100)
  usedCount    Int      @default(0)
  expiresAt    DateTime?
  active       Boolean  @default(true)
  isFlashDeal Boolean  @default(false)
  flashDealExpiresAt DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())

  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())

  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int      @default(1)

  /**
   * Presentacion elegida (0 = ninguna). El `id` es el `variation_id` de Dropi.
   * `variationName` se guarda para poder mostrarlo aunque la variacion desaparezca
   * del catalogo. Entra en el indice unico para poder tener el mismo producto en
   * dos presentaciones distintas dentro del carrito.
   */
  variationId   Int     @default(0)
  variationName String?

  /**
   * La linea salio del selector de promociones de la landing: cobra el precio
   * de oferta por cantidad (2 frascos = $99.900, 3 = $129.900). `false` =
   * compra normal desde la ficha: precio por unidad por la cantidad pedida.
   */
  promotion     Boolean @default(false)

  @@unique([cartId, productId, variationId])
}

model Order {
  id        String       @id @default(cuid())

  // Dropi/WooCommerce requiere IDs de pedido numéricos enteros
  numericId Int          @unique @default(autoincrement())

  // Pedido de invitado (checkout sin sesión): sin cuenta asociada.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  total     Decimal      @db.Decimal(10,2)
  status    OrderStatus  @default(PENDING)
  paymentMethod String   @default("CASH_ON_DELIVERY")

  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingEmail   String?
  notes           String?
  idempotencyKey  String?   @unique

  items      OrderItem[]
  tracking   OrderTracking?
  notificationEvents NotificationEvent[] @relation("OrderNotificationEvents")

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int
  price     Decimal  @db.Decimal(10,2)

  /** Presentacion enviada a Dropi (0 = producto simple). */
  variationId   Int     @default(0)
  variationName String?

  /**
   * La linea compro la promocion de la landing. Se guarda en el pedido para
   * que el precio registrado (`price`) se pueda auditar: si es `true`, ese
   * precio es el de oferta por cantidad; si no, el precio normal.
   */
  promotion     Boolean @default(false)

  @@index([orderId])
}

model OrderTracking {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dropiOrderId  String?
  dropiGuideId  String?
  trackingUrl   String?
  guidePdfUrl   String?
  carrier       String?
  status        String   @default("PENDING")
  lastEvent     String?
  rawResponse   Json?
  checkedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatSession {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestId   String?
  guestSecretHash String?
  intent    ChatIntent   @default(GENERAL)
  state     ConversationState @default(EXPLORING)
  metadata  Json?
  appliedDiscountId String?
  messages  ChatMessage[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([guestId])
  @@index([updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String      @db.Text
  toolCalls Json?
  toolResults Json?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/// Ajustes de la tienda que antes vivian en un `settings.json` en disco (logo y
/// video del banner). En un servicio sin disco persistente ese archivo se
/// perdia en cada deploy, asi que el valor tiene que vivir en la base de datos.
/// Clave-valor para no tocar el esquema cada vez que aparece un ajuste nuevo.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Dispositivo movil registrado para recibir notificaciones push de FCM.
/// Un administrador asocia su token FCM con su cuenta para recibir alertas
/// de pedidos, cambios de estado y cancelaciones.
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}

/// Evento de notificacion pendiente (patron Outbox) para envio fiable via FCM.
/// Se persiste dentro de la misma transacción que modifica el pedido, de modo
/// que una caida temporal de Firebase nunca pierde una notificacion.
/// Soporta bloqueo distribuido (lockedAt/lockedBy/lockedUntil) para evitar que
/// dos instancias de Railway procesen el mismo evento simultaneamente, y
/// nextAttemptAt para reintentos con backoff exponencial.
model NotificationEvent {
  id           String   @id @default(cuid())
  eventId      String   @unique // Identificador unico para deduplicacion
  type         String   // ORDER_CREATED | ORDER_STATUS_CHANGED | ORDER_CANCELLED
  orderId      String   // ID del pedido relacionado
  numericId    Int      // Numero de pedido para mostrar en la notificacion
  payload      Json     // Datos adicionales enviados a FCM
  status       String   @default("PENDING") // PENDING | PROCESSING | SENT | FAILED | DEAD | SKIPPED
  attempts     Int      @default(0)
  maxAttempts  Int      @default(5)
  nextAttemptAt DateTime? // Momento a partir del cual se puede reintentar (backoff)
  lastError    String?
  processedAt  DateTime?
  // Bloqueo distribuido: solo la instancia que puso el lock puede modificar el evento.
  lockedAt     DateTime? // Momento en que se adquirió el lock
  lockedBy     String?   // Identificador de la instancia que posee el lock
  lockedUntil  DateTime? // Momento en que expira el lock (recuperación tras caída)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order  Order @relation("OrderNotificationEvents", fields: [orderId], references: [id])

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([eventId])
}