generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ChatIntent {
  PURCHASE
  PRODUCT_INFO
  ORDER_STATUS
  SHIPPING
  SUPPORT
  GENERAL
}

enum ConversationState {
  EXPLORING
  COMPARING
  INTENT_TO_BUY
  CHECKOUT_READY
  ABANDONED
  RESOLVED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  googleId          String?   @unique
  role              Role      @default(CUSTOMER)
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  verificationCode        String?
  verificationCodeExpiry  DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  cart      Cart?
  orders    Order[]

  sessions      Session[]
  chatSessions  ChatSession[]
  createdAt     DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  price       Decimal   @db.Decimal(10,2)
  oldPrice    Decimal?  @db.Decimal(10,2)
  customCode      String?
  dropiProductId  Int?
  stock               Int
  lowStockThreshold   Int       @default(5)
  image       String?
  gallery     String[]
  video       String?
  active      Boolean   @default(true)

  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  cartItems   CartItem[]
  orderItems  OrderItem[]

  embedding   ProductEmbedding?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductEmbedding {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vector    Unsupported("vector(1536)")?
  model     String   @default("text-embedding-3-small")
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model DiscountCode {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  discountType String  @default("PERCENTAGE")
  discountValue Decimal @db.Decimal(5,2)
  minPurchase  Decimal? @db.Decimal(10,2)
  maxUses      Int      @default(100)
  usedCount    Int      @default(0)
  expiresAt    DateTime?
  active       Boolean  @default(true)
  isFlashDeal Boolean  @default(false)
  flashDealExpiresAt DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cart {
  id        String     @id @default(cuid())

  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])

  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())

  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int      @default(1)

  @@unique([cartId, productId])
}

model Order {
  id        String       @id @default(cuid())

  userId    String
  user      User         @relation(fields: [userId], references: [id])

  total     Decimal      @db.Decimal(10,2)
  status    OrderStatus  @default(PENDING)
  paymentMethod String   @default("CASH_ON_DELIVERY")

  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingEmail   String?
  notes           String?
  idempotencyKey  String?   @unique

  items      OrderItem[]
  tracking   OrderTracking?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int
  price     Decimal  @db.Decimal(10,2)

  @@index([orderId])
}

model OrderTracking {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dropiGuideId  String?
  carrier       String?
  status        String   @default("PENDING")
  lastEvent     String?
  rawResponse   Json?
  checkedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatSession {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestId   String?
  guestSecretHash String?
  intent    ChatIntent   @default(GENERAL)
  state     ConversationState @default(EXPLORING)
  metadata  Json?
  appliedDiscountId String?
  messages  ChatMessage[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([guestId])
  @@index([updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String      @db.Text
  toolCalls Json?
  toolResults Json?
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}